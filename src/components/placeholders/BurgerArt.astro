---
// Drawn stand-in for the hero's cut-out photo until real photos arrive.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg viewBox="0 0 440 400" class={className} role="img" aria-label="Burger">
  <circle cx="220" cy="196" r="172" fill="var(--theme-accent)" />
  <ellipse cx="220" cy="370" rx="150" ry="14" fill="#000" opacity="0.25" />

  <g transform="translate(0 14)">
    <!-- bottom bun -->
    <path d="M86 290h268c0 30-22 52-52 52H138c-30 0-52-22-52-52z" fill="#d98a32" />
    <path d="M86 290h268v8H86z" fill="#c4772a" />

    <!-- patty -->
    <rect x="74" y="246" width="292" height="48" rx="24" fill="#5a3121" />
    <path d="M96 262c20-6 40 6 60 0s40 6 60 0 40 6 60 0 40 6 60 0" stroke="#3f2117" stroke-width="5" fill="none" stroke-linecap="round" />

    <!-- cheese -->
    <path d="M78 238h284l-24 18-18 26-16-26-36 0-20 30-18-30-60 0-16 22-14-22-36 0z" fill="#ffc62e" />

  </g>

  <!-- tomato -->
  <rect x="88" y="232" width="264" height="26" rx="13" fill="#e8402a" />

  <!-- lettuce -->
  <path d="M68 224q15-14 30 0t30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 30 0 6 8v6c0 6-6 10-14 10H82c-8 0-14-4-14-10z" fill="#55b33b" />

  <!-- top bun -->
  <path d="M74 206c0-74 66-124 146-124s146 50 146 124c0 8-6 12-14 12H88c-8 0-14-4-14-12z" fill="#e89a3c" />
  <path d="M104 160c18-38 60-62 116-62" stroke="#f7c27a" stroke-width="10" fill="none" stroke-linecap="round" opacity="0.7" />
  <g fill="#fff3d6">
    <ellipse cx="170" cy="130" rx="7" ry="4" transform="rotate(-20 170 130)" />
    <ellipse cx="220" cy="112" rx="7" ry="4" />
    <ellipse cx="270" cy="128" rx="7" ry="4" transform="rotate(20 270 128)" />
    <ellipse cx="196" cy="156" rx="7" ry="4" transform="rotate(10 196 156)" />
    <ellipse cx="248" cy="160" rx="7" ry="4" transform="rotate(-10 248 160)" />
    <ellipse cx="300" cy="166" rx="7" ry="4" transform="rotate(25 300 166)" />
    <ellipse cx="142" cy="170" rx="7" ry="4" transform="rotate(-25 142 170)" />
  </g>
</svg>
