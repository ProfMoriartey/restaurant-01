---
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import { privacyHref } from '../lib/nav';
import { settings } from '../site.config';
import type { Content, SocialPlatform } from '../lib/types';

interface Props {
  content: Content;
  lang: string;
}

const { content, lang } = Astro.props;
const { contact, locations, ui } = content;
const { mapEmbedUrl } = settings;
const directionsUrl = locations.find((l) => l.directionsUrl)?.directionsUrl;

const platformNames: Record<SocialPlatform, string> = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  tiktok: 'TikTok',
  x: 'X',
  youtube: 'YouTube',
  whatsapp: 'WhatsApp',
};
---

<footer
  id="contact"
  class="bg-(--theme-footer-bg) [background-image:var(--theme-footer-image)] px-4 pt-16 pb-8 text-(--theme-footer-ink) lg:pt-24"
  style="--title-shadow: var(--theme-footer-shadow); --button-bg: var(--theme-footer-button-bg); --button-ink: var(--theme-footer-button-ink); --button-hover-bg: var(--theme-footer-button-hover-bg); --button-hover-ink: var(--theme-footer-button-hover-ink)"
>
  <div class="mx-auto max-w-site lg:px-6">
    <h2 class="section-title text-center text-5xl sm:text-6xl lg:text-[5rem]" data-reveal="left">{contact.title}</h2>
    <p class="mt-4 text-center font-display text-xl font-bold" data-reveal="up">{contact.subtitle}</p>

    {
      settings.social.length > 0 && (
        <ul class="mt-8 flex justify-center gap-3" data-reveal="up">
          {settings.social.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener"
                aria-label={platformNames[s.platform]}
                class="grid size-12 place-items-center rounded-lg bg-(--theme-footer-icon) text-(--theme-footer-bg) transition-transform duration-300 hover:-translate-y-1"
              >
                <Icon name={s.platform} class="size-6" />
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div
      class:list={[
        'mt-14 grid gap-12',
        mapEmbedUrl && 'mx-auto max-w-5xl items-center lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16',
      ]}
    >
      <div class:list={['flex flex-wrap gap-x-16 gap-y-12', !mapEmbedUrl && 'justify-center']}>
        {
          locations.map((location) => (
            <div class="w-full max-w-xs font-small text-[15px]" data-reveal="up">
              <h3 class="font-display text-xl font-extrabold uppercase">{location.name}</h3>
              <dl class="mt-5 space-y-3">
                <div class="flex gap-3">
                  <dt>
                    <Icon name="phone" class="size-5 text-(--theme-footer-icon)" />
                    <span class="sr-only">{contact.labels.phone}</span>
                  </dt>
                  <dd>
                    <a href={`tel:${location.phone.replace(/\s/g, '')}`} class="hover:underline">
                      {location.phone}
                    </a>
                  </dd>
                </div>
                <div class="flex gap-3">
                  <dt>
                    <Icon name="mail" class="size-5 text-(--theme-footer-icon)" />
                    <span class="sr-only">{contact.labels.email}</span>
                  </dt>
                  <dd>
                    <a href={`mailto:${location.email}`} class="hover:underline">
                      {location.email}
                    </a>
                  </dd>
                </div>
                <div class="flex gap-3">
                  <dt>
                    <Icon name="pin" class="size-5 text-(--theme-footer-icon)" />
                    <span class="sr-only">{contact.labels.address}</span>
                  </dt>
                  <dd>{location.address}</dd>
                </div>
                <div class="flex gap-3">
                  <dt>
                    <Icon name="clock" class="size-5 text-(--theme-footer-icon)" />
                    <span class="sr-only">{contact.labels.hours}</span>
                  </dt>
                  <dd>
                    {location.hours.map((line) => (
                      <span class="block">{line}</span>
                    ))}
                    <OpenStatus location={location} lang={lang} labels={ui.status} class="mt-2" />
                  </dd>
                </div>
              </dl>
            </div>
          ))
        }
      </div>

      {
        mapEmbedUrl && (
          <div data-reveal="up">
            {/* Nothing is requested from Google until the visitor asks for the map. */}
            <div
              class="relative aspect-[16/10] overflow-hidden rounded-2xl border-4 border-current bg-cover bg-center bg-no-repeat [background-image:var(--tex-map)]"
              data-map={mapEmbedUrl}
              data-map-title={contact.mapTitle}
            >
              <div class="absolute inset-0 grid place-items-center p-6 text-center" data-map-placeholder>
                <div class="max-w-xs">
                  <Icon name="pin" class="mx-auto size-10" />
                  <p class="mt-3 font-small text-sm">{contact.map.notice}</p>
                  <button type="button" class="pill mt-4" data-map-load>
                    {contact.map.show}
                  </button>
                </div>
              </div>
            </div>
            {directionsUrl && (
              <a href={directionsUrl} class="pill mt-6" target="_blank" rel="noopener">
                {contact.directions}
              </a>
            )}
          </div>
        )
      }
    </div>

    <p class="mt-16 border-t border-current/20 pt-6 text-center font-small text-sm opacity-80">
      © {new Date().getFullYear()} {settings.name}. {contact.rights}
      <span aria-hidden="true" class="mx-2">·</span>
      <a href={privacyHref(lang, content.privacy.slug)} class="underline underline-offset-4 hover:no-underline">
        {contact.privacyLink}
      </a>
    </p>
  </div>
</footer>
