---
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { settings } from '../site.config';
import { navLinks } from '../lib/nav';
import { withBase } from '../lib/paths';
import type { Content } from '../lib/types';

interface Props {
  lang: string;
  content: Content;
  page?: 'home' | 'privacy';
}

const { lang, content, page = 'home' } = Astro.props;
const links = navLinks(settings, content);
const home = getRelativeLocaleUrl(lang);
// Section links jump within the home page, or back to it from other pages.
const base = page === 'home' ? '' : home;
// On phones the header floats over the hero when the page opens with one.
const overlay = page === 'home' && settings.sections.hero;
---

<header class="site-header" data-header="top" data-overlay={overlay ? '' : undefined}>
  <div class="mx-auto flex h-16 max-w-site items-center justify-between px-4 lg:h-40 lg:px-6">
    <a href={home} class="block shrink-0">
      <img
        src={withBase(settings.logo.src)}
        alt={settings.name}
        width={settings.logo.width}
        height={settings.logo.height}
        class="size-12 rounded-lg lg:size-[125px] lg:rounded-none"
      />
    </a>

    <nav aria-label={settings.name} class="hidden lg:block">
      <ul class="flex items-center gap-9 text-[17px]">
        {
          links.map((link) => (
            <li>
              <a href={`${base}#${link.id}`} class="nav-link" data-nav-link>
                {link.label}
              </a>
            </li>
          ))
        }
        <li><LanguageSwitcher lang={lang} page={page} class="text-[17px]" /></li>
      </ul>
    </nav>

    <div class="flex items-center gap-1 lg:hidden">
      <LanguageSwitcher lang={lang} page={page} class="text-sm [&_a]:inline-block [&_a]:px-2 [&_a]:py-3" />
      <button
        type="button"
        class="-mr-1.5 grid size-11 place-items-center"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only">{content.ui.openMenu}</span>
        <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>
{!overlay && <div class="h-16 lg:hidden" aria-hidden="true" />}

<div class="mobile-backdrop fixed inset-0 z-40 bg-black/50 lg:hidden" data-menu-close aria-hidden="true"></div>
<div
  id="mobile-menu"
  class="mobile-panel fixed inset-y-0 right-0 z-50 flex w-[70%] max-w-80 min-w-[17rem] flex-col bg-panel px-8 pt-6 pb-10 text-panel-ink lg:hidden"
  data-menu-panel
>
  <button type="button" class="ml-auto grid size-11 place-items-center" data-menu-close>
    <span class="sr-only">{content.ui.closeMenu}</span>
    <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
    </svg>
  </button>
  <nav aria-label={settings.name} class="mt-6">
    <ul class="flex flex-col gap-6 text-xl">
      {
        links.map((link) => (
          <li>
            <a href={`${base}#${link.id}`} class="nav-link" data-nav-link>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
