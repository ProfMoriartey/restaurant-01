---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { settings, content } from '../site.config';
import { privacyHref } from '../lib/nav';

interface Props {
  lang: string;
  /** The page being shown, so each language links to the same page. */
  page?: 'home' | 'privacy';
  class?: string;
}

const { lang, page = 'home', class: className } = Astro.props;
const hrefFor = (code: string) =>
  page === 'privacy' ? privacyHref(code, content[code].privacy.slug) : getRelativeLocaleUrl(code);
---

{
  settings.languages.length > 1 && (
    <ul class:list={['flex items-center gap-1', className]} aria-label={content[lang].ui.switchLanguage}>
      {settings.languages.map((code, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <span aria-hidden="true" class="opacity-40">/</span>}
          <a
            href={hrefFor(code)}
            hreflang={code}
            lang={code}
            aria-label={content[code].languageName}
            aria-current={code === lang ? 'true' : undefined}
            class="nav-link px-1 aria-[current=true]:text-accent"
          >
            {code}
          </a>
        </li>
      ))}
    </ul>
  )
}
