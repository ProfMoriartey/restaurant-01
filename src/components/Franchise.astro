---
import { settings } from '../site.config';
import type { Content } from '../lib/types';

interface Props {
  content: Content;
}

const { franchise } = Astro.props.content;
---

<section
  id="franchise"
  class="stripes bg-(--theme-franchise-bg) px-4 py-16 text-(--theme-franchise-ink) lg:py-24"
  style="--title-shadow: var(--theme-franchise-shadow)"
>
  <div class="mx-auto max-w-3xl">
    <h2 class="section-title text-center text-5xl sm:text-6xl lg:text-[5rem]" data-reveal="left">
      {franchise.title}
    </h2>
    <p class="mt-6 text-center font-small" data-reveal="up">{franchise.intro}</p>
    <form
      action={settings.franchiseFormAction}
      method="post"
      class="mt-10 grid gap-5 sm:grid-cols-2"
      data-reveal="up"
    >
      {
        franchise.fields.map((field) => (
          <label class:list={['block', field.wide && 'sm:col-span-2']}>
            <span class="mb-2 block font-small text-sm font-medium">
              {field.label}
              {field.required && <span aria-hidden="true"> *</span>}
            </span>
            {field.type === 'textarea' ? (
              <textarea name={field.name} rows="5" required={field.required} class="field" />
            ) : (
              <input type={field.type} name={field.name} required={field.required} class="field" />
            )}
          </label>
        ))
      }
      <button
        type="submit"
        class="mt-2 min-h-12 rounded-full bg-(--theme-submit-bg) py-4 font-display text-lg font-extrabold text-(--theme-submit-ink) uppercase transition-opacity duration-300 hover:opacity-85 sm:col-span-2"
      >
        {franchise.submit}
      </button>
    </form>
  </div>
</section>
