---
import { settings } from '../site.config';
import type { Content } from '../lib/types';

interface Props {
  content: Content;
}

const { order, visit, locations } = Astro.props.content;
const { mapEmbedUrl } = settings;
const directionsUrl = locations.find((l) => l.directionsUrl)?.directionsUrl;
---

<section id="order" class:list={['grid', mapEmbedUrl && 'lg:grid-cols-2']}>
  <div
    class="bg-(--theme-order-bg) px-4 py-16 text-(--theme-order-ink) lg:px-0 lg:py-24"
    style="--title-shadow: var(--theme-order-shadow)"
  >
    <div class:list={['w-full lg:px-12', mapEmbedUrl ? 'ml-auto max-w-[39.6875rem]' : 'mx-auto max-w-site']}>
      <h2 class="section-title text-5xl sm:text-6xl lg:text-[4.5rem]" data-reveal="left">{order.title}</h2>
      {
        locations.map((location) => (
          <div class="mt-10" data-reveal="up">
            <h3 class="font-display text-xl font-extrabold underline decoration-2 underline-offset-8">
              {location.name}
            </h3>
            {location.deliveryApps.length ? (
              <ul class="mt-6 flex flex-wrap gap-3">
                {location.deliveryApps.map((app) => (
                  <li>
                    <a href={app.url} class="pill" target="_blank" rel="noopener">
                      {app.name}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4">{order.noApps}</p>
            )}
          </div>
        ))
      }
    </div>
  </div>

  {
    mapEmbedUrl && (
      <div
        class="bg-(--theme-visit-bg) px-4 py-16 text-(--theme-visit-ink) lg:px-0 lg:py-24"
        style="--title-shadow: var(--theme-visit-shadow); --button-bg: var(--theme-visit-button-bg); --button-ink: var(--theme-visit-button-ink); --button-hover-bg: var(--theme-visit-button-hover-bg); --button-hover-ink: var(--theme-visit-button-hover-ink)"
      >
        <div class="mr-auto w-full max-w-[39.6875rem] lg:px-12">
          <h2 class="section-title text-5xl sm:text-6xl lg:text-[4.5rem]" data-reveal="left">
            {visit.title}
          </h2>
          <p class="mt-6 font-small" data-reveal="up">{visit.text}</p>
          <div class="mt-8 aspect-[16/10] overflow-hidden rounded-2xl border-4 border-current" data-reveal="up">
            <iframe
              src={mapEmbedUrl}
              title={visit.mapTitle}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
              class="size-full"
            />
          </div>
          {directionsUrl && (
            <a href={directionsUrl} class="pill mt-6" target="_blank" rel="noopener">
              {visit.directions}
            </a>
          )}
        </div>
      </div>
    )
  }
</section>
