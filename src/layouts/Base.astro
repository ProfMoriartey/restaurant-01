---
import '@fontsource-variable/outfit';
import '@fontsource-variable/inter';
import '@fontsource/roboto-slab/400.css';
import '@fontsource/roboto-slab/600.css';
import '@fontsource/roboto-slab/700.css';
import '@fontsource/roboto-slab/800.css';
import '@fontsource/roboto-slab/900.css';
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { settings, content as allContent } from '../site.config';
import { restaurantSchema } from '../lib/seo';
import type { Content, ThemeId } from '../lib/types';

interface Props {
  lang: string;
  content: Content;
  /** Page title, when it is not the home page. */
  title?: string;
  /** The same page in every language, as paths; defaults to the home page. */
  alternates?: Record<string, string>;
}

const { lang, content, title, alternates } = Astro.props;
const { meta } = content;
const pageTitle = title ? `${title} | ${settings.name}` : meta.title;
const alternateUrl = (code: string) =>
  alternates ? new URL(alternates[code], Astro.site).href : getAbsoluteLocaleUrl(code);
const site = Astro.site?.href;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const absolute = (path: string) => (site ? new URL(path, site).href : path);

// Colour of the phone browser bar: the theme's header colour.
const browserColor: Record<ThemeId, string> = { 'flu-burger': '#ffffff', 'retro-diner': '#560006' };
---

<!doctype html>
<html lang={lang} data-theme={settings.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content={browserColor[settings.theme]} />
    <link rel="icon" type="image/png" sizes="32x32" href={settings.icons.favicon} />
    <link rel="apple-touch-icon" href={settings.icons.appleTouch} />

    {/* The same page in each language, for search engines. */}
    {site && <link rel="canonical" href={pageUrl.href} />}
    {
      site &&
        settings.languages.map((code) => (
          <link rel="alternate" hreflang={code} href={alternateUrl(code)} />
        ))
    }
    {site && <link rel="alternate" hreflang="x-default" href={alternateUrl(settings.defaultLanguage)} />}
    {site && <link rel="sitemap" href="/sitemap-index.xml" />}

    {/* Link previews on WhatsApp, Instagram, Facebook and X. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:locale" content={meta.locale} />
    {
      settings.languages
        .filter((code) => code !== lang)
        .map((code) => <meta property="og:locale:alternate" content={allContent[code].meta.locale} />)
    }
    {site && <meta property="og:url" content={pageUrl.href} />}
    <meta property="og:image" content={absolute(meta.shareImage.src)} />
    <meta property="og:image:width" content={String(meta.shareImage.width)} />
    <meta property="og:image:height" content={String(meta.shareImage.height)} />
    <meta property="og:image:alt" content={meta.shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Business details for Google: address, hours, phone, menu. */}
    {
      !alternates &&
        restaurantSchema(settings, content, pageUrl, site).map((schema) => (
          <script type="application/ld+json" set:html={JSON.stringify(schema)} />
        ))
    }
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-screen">
    <slot />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
