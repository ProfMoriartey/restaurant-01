---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import MenuCard from '../components/MenuCard.astro';
import InfoStrip from '../components/InfoStrip.astro';
import Categories from '../components/Categories.astro';
import Order from '../components/Order.astro';
import Franchise from '../components/Franchise.astro';
import Contact from '../components/Contact.astro';
import QuickBar from '../components/QuickBar.astro';
import { settings, content } from '../site.config';
import type { SectionId } from '../lib/types';

// One page per language: the default at `/`, the others at `/<code>`.
export function getStaticPaths() {
  return settings.languages.map((code) => ({
    params: { lang: code === settings.defaultLanguage ? undefined : code },
    props: { lang: code },
  }));
}

const { lang } = Astro.props;
const text = content[lang];

const components = {
  hero: Hero,
  menu: MenuCard,
  infoStrip: InfoStrip,
  categories: Categories,
  order: Order,
  franchise: Franchise,
} satisfies Record<Exclude<SectionId, 'contact'>, unknown>;

// Sections in the order the settings list them; the contact footer always closes the page.
const sections = (Object.keys(settings.sections) as SectionId[]).filter(
  (id): id is keyof typeof components => id !== 'contact' && settings.sections[id],
);
---

<Base lang={lang} content={text}>
  <Header lang={lang} content={text} />
  <!-- Light bands separate the coloured sections, as in the theme's --theme-band. -->
  <main class="flex flex-col gap-(--theme-band-gap) bg-(--theme-band) [background-image:var(--theme-band-image)] pb-(--theme-band-gap)">
    {
      sections.map((id) => {
        const Section = components[id];
        return <Section content={text} lang={lang} />;
      })
    }
  </main>
  {settings.sections.contact && <Contact content={text} lang={lang} />}
  <QuickBar content={text} lang={lang} />
</Base>
