---
// Privacy notice (KVKK aydınlatma metni), one page per language, e.g. /gizlilik and /en/privacy.
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import QuickBar from '../../components/QuickBar.astro';
import { settings, content } from '../../site.config';
import { privacyHref } from '../../lib/nav';

export function getStaticPaths() {
  return settings.languages.map((code) => ({
    params: { lang: code === settings.defaultLanguage ? undefined : code, slug: content[code].privacy.slug },
    props: { lang: code },
  }));
}

const { lang } = Astro.props;
const text = content[lang];
const { privacy } = text;
const home = getRelativeLocaleUrl(lang);
const alternates = Object.fromEntries(
  settings.languages.map((code) => [code, privacyHref(code, content[code].privacy.slug)]),
);
---

<Base lang={lang} content={text} title={privacy.title} alternates={alternates}>
  <Header lang={lang} content={text} page="privacy" />
  <main class="bg-(--theme-band) [background-image:var(--theme-band-image)] px-4 py-14 lg:py-20">
    <article class="mx-auto max-w-3xl">
      <h1 class="headline text-4xl leading-tight sm:text-5xl">{privacy.title}</h1>
      <p class="mt-3 font-small text-sm opacity-70">{privacy.updated}</p>
      {
        privacy.draftNote && (
          <p class="mt-6 rounded-xl border-2 border-accent bg-accent/10 px-4 py-3 font-small text-sm font-medium">
            {privacy.draftNote}
          </p>
        )
      }
      <p class="mt-8 text-lg leading-relaxed">{privacy.intro}</p>
      {
        privacy.sections.map((section) => (
          <section class="mt-10">
            <h2 class="font-display text-xl font-extrabold uppercase sm:text-2xl">{section.heading}</h2>
            {section.paragraphs.map((p) => (
              <p class="mt-3 leading-relaxed">{p}</p>
            ))}
          </section>
        ))
      }
      <a href={home} class="pill mt-12">{privacy.backHome}</a>
    </article>
  </main>
  <footer class="bg-(--theme-footer-bg) [background-image:var(--theme-footer-image)] px-4 py-8 text-center font-small text-sm text-(--theme-footer-ink)">
    © {new Date().getFullYear()} {settings.name}. {text.contact.rights}
  </footer>
  <QuickBar content={text} lang={lang} base={home} />
</Base>
